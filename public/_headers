# Static Assets - Cache for 1 year (Immutable)
# Because we use query params for versioning (?v=hash), it is safe to cache aggressively.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

# HTML Files - Never cache (SSR content and asset references change together)
/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
